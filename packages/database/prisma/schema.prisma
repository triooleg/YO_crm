generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  PRODUCTION
  ACCOUNTANT
  VIEWER
}

enum ClientStatus {
  LEAD
  ACTIVE
  VIP
  INACTIVE
  BLOCKED
}

enum ContactChannel {
  WEBSITE
  CHATWOOT
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  EMAIL
  TELEGRAM
  REFERRAL
  RETURNING_CUSTOMER
  MANUAL
  OTHER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageStatus {
  RECEIVED
  DRAFT
  SENT
  FAILED
}

enum AiMode {
  OFF
  SHADOW
  ASSIST
  AUTO_SAFE
  AGENT
  AUTONOMOUS
}

enum AiSettingScope {
  GLOBAL
  CHANNEL
  CLIENT
  CONVERSATION
}

enum AiRecordStatus {
  ACTIVE
  VERIFIED
  SUPERSEDED
  REJECTED
}

enum AiRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AiJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum WorkTaskType {
  CLIENT
  ADMINISTRATIVE
  PRODUCTION
}

enum Discipline {
  RHYTHMIC_GYMNASTICS
  ACROBATIC_GYMNASTICS
  FIGURE_SKATING
  AEROBIC_GYMNASTICS
  BATON_TWIRLING_MAJORETTE
  OTHER
}

enum OrderType {
  READY_MODEL
  WEBSITE_SALE
  STOCK_SALE
  CUSTOM_ORDER
  COPY_MODEL
  MODIFIED_MODEL
  PAIR
  GROUP_ORDER
  REPEAT_ORDER
  ACCESSORY
}

enum SalesStatus {
  NEW_LEAD
  WAITING_CLIENT_REPLY
  NEEDS_ESTIMATE
  ESTIMATE_SENT
  DESIGN_DISCUSSION
  WAITING_COACH_APPROVAL
  WAITING_DEPOSIT
  DEPOSIT_RECEIVED
  ORDER_CONFIRMED
  MEASUREMENTS_REQUIRED
  MEASUREMENTS_RECEIVED
  READY_FOR_PRODUCTION
  IN_PRODUCTION
  FINAL_DECORATION
  QUALITY_CONTROL
  PHOTO_SENT
  WAITING_FINAL_PAYMENT
  PAID
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  REVIEW_REQUESTED
  COMPLETED
  CANCELLED
}

enum ProductionStatus {
  NOT_SCHEDULED
  TENTATIVE
  SCHEDULED
  MATERIALS
  CUTTING
  SEWING
  DECORATION
  QUALITY_CONTROL
  READY
  ON_HOLD
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  DEPOSIT_PAID
  PAID
  REFUNDED
  CANCELLED
}

enum ShippingStatus {
  NOT_READY
  READY
  LABEL_CREATED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
  LOST
}

enum OrderFileRole {
  GENERAL
  DESIGN_FRONT
  DESIGN_BACK
  DESIGN_GALLERY
  NOTE_ATTACHMENT
}

enum OrderNoteCategory {
  GENERAL
  CLIENT
  DESIGNS
  MEASUREMENTS
  PRODUCTION
  SHIPPING
  FINANCE
}

enum OrderNoteVisibility {
  INTERNAL
  CUSTOMER_WISH
}

enum ShippingCarrier {
  NOVA_POSHTA
  NOVA_GLOBAL
  UKRPOSHTA
  DHL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum OrderDocumentKind {
  INVOICE
  ORDER_SUMMARY
  CUSTOMER_CARD
  CUSTOM
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  PAYPAL
  CASH
  OTHER
}

enum BackupType {
  DATA
  FULL
}

enum BackupStatus {
  PENDING
  RUNNING
  VERIFYING
  COMPLETED
  FAILED
  RESTORING
}

enum BackupStorageProvider {
  LOCAL
  S3
}

enum KeycrmSyncMode {
  DRY_RUN
  APPLY
}

enum KeycrmSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  passwordHash             String
  displayName              String
  role                     UserRole                  @default(MANAGER)
  active                   Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  archivedAt               DateTime?
  sessions                 Session[]
  clients                  Client[]                  @relation("ClientManager")
  orders                   Order[]                   @relation("OrderManager")
  compositionOperations    OrderCompositionOperation[]
  auditLogs                AuditLog[]                @relation("AuditActor")
  authoredMessages         Message[]                 @relation("MessageAuthor")
  communicationAttachments CommunicationAttachment[]
  assignedTasks            WorkTask[]                @relation("TaskAssignee")
  createdTasks             WorkTask[]                @relation("TaskCreator")
  createdBackups           Backup[]                  @relation("BackupCreator")
  keycrmSyncRuns               KeycrmSyncRun[]           @relation("KeycrmSyncRunCreator")
  createdKnowledgeItems    KnowledgeItem[]           @relation("KnowledgeCreatedBy")
  updatedKnowledgeItems    KnowledgeItem[]           @relation("KnowledgeUpdatedBy")
  updatedAiRuntimeSettings AiRuntimeSetting[]         @relation("AiRuntimeSettingUpdatedBy")
  createdClientMergeOperations ClientMergeOperation[] @relation("ClientMergeOperationCreator")
  splitClientMergeOperations   ClientMergeOperation[] @relation("ClientMergeOperationSplitter")
  uploadedOrderFiles        OrderFile[]                @relation("OrderFileUploader")
  uploadedClientFiles       ClientFile[]               @relation("ClientFileUploader")
  authoredActivities        Activity[]                 @relation("ActivityActor")
  authoredOrderNotes        OrderNote[]                @relation("OrderNoteAuthor")
  editedOrderNoteRevisions  OrderNoteRevision[]        @relation("OrderNoteRevisionEditor")
  parentMeasurementInvitations MeasurementInvitation[] @relation("ParentMeasurementInvitationIssuer")
  parentMeasurementAssignments MeasurementSubmissionTarget[] @relation("ParentMeasurementTargetActor")
  parentMeasurementEvents MeasurementPublicEvent[] @relation("ParentMeasurementEventActor")
  createdWebsiteApiKeys WebsiteApiKey[] @relation("WebsiteApiKeyCreator")
  revokedWebsiteApiKeys WebsiteApiKey[] @relation("WebsiteApiKeyRevoker")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Client {
  id                      String                   @id @default(cuid())
  firstName               String
  lastName                String?
  displayName             String
  avatarUrl               String?
  country                 String?
  city                    String?
  address                 String?
  postalCode              String?
  email                   String?
  phone                   String?
  whatsapp                String?
  instagram               String?
  instagramUsername       String?
  facebook                String?
  telegram                String?
  preferredChannel        ContactChannel?
  language                String?
  timezone                String?
  firstContactAt          DateTime?
  source                  ContactChannel           @default(MANUAL)
  status                  ClientStatus             @default(LEAD)
  notes                   String?
  preferences             Json?
  responsibleManagerId    String?
  nextActionAt            DateTime?
  lastContactAt           DateTime?
  inboxSpamAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  archivedAt              DateTime?
  responsibleManager      User?                    @relation("ClientManager", fields: [responsibleManagerId], references: [id])
  athletes                Athlete[]
  orders                  Order[]
  activities              Activity[]
  conversations           Conversation[]
  messageDeliveryAttempts MessageDeliveryAttempt[]
  workTasks               WorkTask[]
  aiMemories              CustomerMemory[]
  conversationFacts       ConversationFact[]
  agreements              Agreement[]
  aiRuns                  AiRun[]
  aiModeOverrides         AiModeOverride[]
  aiRuntimeSettings       AiRuntimeSetting[]        @relation("AiRuntimeSettingClient")
  mergeRedirectSource     ClientMergeRedirect?      @relation("MergedClientSource")
  incomingMergeRedirects  ClientMergeRedirect[]     @relation("MergedClientTarget")
  mergeOperationsAsSource ClientMergeOperation[]    @relation("ClientMergeOperationSource")
  mergeOperationsAsTarget ClientMergeOperation[]    @relation("ClientMergeOperationTarget")
  keycrmLinks             KeycrmClientLink[]
  files                   ClientFile[]

  @@index([displayName])
  @@index([email])
  @@index([phone])
  @@index([status, archivedAt])
  parentMeasurementInvitations MeasurementInvitation[] @relation("ParentMeasurementInvitationClient")
}

model ClientMergeRedirect {
  sourceClientId String   @id
  targetClientId String
  createdById    String?
  createdAt      DateTime @default(now())
  sourceClient   Client   @relation("MergedClientSource", fields: [sourceClientId], references: [id], onDelete: Restrict)
  targetClient   Client   @relation("MergedClientTarget", fields: [targetClientId], references: [id], onDelete: Restrict)

  @@index([targetClientId])
}

model ClientMergeOperation {
  id                   String   @id @default(cuid())
  sourceClientId       String
  targetClientId       String
  createdById          String
  splitById            String?
  sourceSnapshot       Json
  targetBeforeSnapshot Json
  targetAfterSnapshot  Json
  movedEntityIds       Json
  deletedAiSettings    Json
  createdAt            DateTime @default(now())
  splitAt              DateTime?
  sourceClient         Client   @relation("ClientMergeOperationSource", fields: [sourceClientId], references: [id], onDelete: Restrict)
  targetClient         Client   @relation("ClientMergeOperationTarget", fields: [targetClientId], references: [id], onDelete: Restrict)
  createdBy            User     @relation("ClientMergeOperationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  splitBy              User?    @relation("ClientMergeOperationSplitter", fields: [splitById], references: [id], onDelete: Restrict)

  @@index([sourceClientId, splitAt])
  @@index([targetClientId, splitAt])
}

model Athlete {
  id           String        @id @default(cuid())
  clientId     String
  firstName    String
  lastName     String?
  birthDate    DateTime?
  discipline   Discipline?
  club         String?
  coach        String?
  country      String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  archivedAt   DateTime?
  client       Client        @relation(fields: [clientId], references: [id])
  measurements Measurement[]
  orders       Order[]
  orderItems   OrderItem[]
  orderItemInstances OrderItemInstance[]
  orderNotes   OrderNote[]

  @@index([clientId, archivedAt])
  parentMeasurementChildren MeasurementParticipantChild[] @relation("ParentMeasurementChildAthlete")
  parentMeasurementSubmissions MeasurementSubmission[] @relation("ParentMeasurementSubmissionAthlete")
}

model Measurement {
  id         String      @id @default(cuid())
  athleteId  String
  measuredAt DateTime
  unit       String      @default("cm")
  height     Decimal?    @db.Decimal(6, 2)
  chest      Decimal?    @db.Decimal(6, 2)
  waist      Decimal?    @db.Decimal(6, 2)
  hips       Decimal?    @db.Decimal(6, 2)
  torso      Decimal?    @db.Decimal(6, 2)
  values     Json?
  notes      String?
  source     String?
  definitionVersion String?
  parentSubmissions MeasurementSubmission[]
  createdAt  DateTime    @default(now())
  archivedAt DateTime?
  athlete    Athlete     @relation(fields: [athleteId], references: [id])
  orders     Order[]
  orderItems OrderItem[]
  orderItemInstances OrderItemInstance[]

  @@index([athleteId, measuredAt])
  @@index([athleteId, archivedAt, measuredAt])
  parentAssignmentsBefore MeasurementSubmissionTarget[] @relation("ParentMeasurementTargetBefore")
  parentAssignmentsAfter MeasurementSubmissionTarget[] @relation("ParentMeasurementTargetAfter")
}

model Order {
  taxEntries TaxEntry[]
  measurementInvitations MeasurementInvitation[]
  id                   String           @id @default(cuid())
  number               String           @unique
  clientId             String
  athleteId            String?
  measurementId        String?
  type                 OrderType
  discipline           Discipline?
  country              String?
  deliveryAddressSet   Boolean          @default(false)
  deliveryRecipient    String?
  deliveryRecipientPhone String?
  deliveryEmail          String?
  deliveryAddressLine1 String?
  deliveryAddressLine2 String?
  deliveryCity         String?
  deliveryRegion       String?
  deliveryPostalCode   String?
  deliveryAddressText  String?
  deliveryServiceName    String?
  deliveryTrackingCode  String?
  requiredDeliveryAt   DateTime?
  promisedProductionAt DateTime?
  priority             Int              @default(0)
  responsibleManagerId String?
  productionOwner      String?
  priceMinor           Int
  currency             String           @default("EUR")
  depositRequiredMinor Int
  deliveryMinor        Int              @default(0)
  discountMinor        Int              @default(0)
  taxMinor               Int              @default(0)
  giftWrapMinor          Int              @default(0)
  productionCostMinor  Int?
  salesStatus          SalesStatus      @default(NEW_LEAD)
  productionStatus     ProductionStatus @default(NOT_SCHEDULED)
  paymentStatus        PaymentStatus    @default(UNPAID)
  shippingStatus       ShippingStatus   @default(NOT_READY)
  notes                String?
  buyerComment           String?
  managerComment         String?
  giftMessage            String?
  promocode              String?
  isGift                 Boolean          @default(false)
  modelImagePath       String?
  externalImageUrl     String?
  sourceSystem           String?
  sourceAccount          String?
  sourceLinkMode         String?
  externalId             String?
  externalNumber         String?
  externalUpdatedAt      DateTime?
  externalData           Json?
  websiteNoticeAt        DateTime?
  websiteReviewedAt      DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  archivedAt           DateTime?
  client               Client           @relation(fields: [clientId], references: [id])
  athlete              Athlete?         @relation(fields: [athleteId], references: [id])
  measurement          Measurement?     @relation(fields: [measurementId], references: [id])
  responsibleManager   User?            @relation("OrderManager", fields: [responsibleManagerId], references: [id])
  items                OrderItem[]
  compositionOperations OrderCompositionOperation[]
  payments             Payment[]
  productionSlot       ProductionSlot?
  activities           Activity[]
  files                OrderFile[]
  notesStructured      OrderNote[]
  tags                 OrderTag[]

  invoices   Invoice[]
  documents  OrderDocument[]
  expenses   Expense[]
  shipment   Shipment?
  orderShipments OrderShipment[]
  agreements Agreement[]

  @@unique([sourceSystem, sourceAccount, externalId])
  @@index([salesStatus, archivedAt])
  @@index([requiredDeliveryAt])
  @@index([clientId, createdAt])
  @@index([websiteReviewedAt, websiteNoticeAt, archivedAt])
}

model OrderFile {
  id           String   @id @default(cuid())
  orderId      String
  uploadedById String
  orderItemId  String?
  noteId       String?
  name         String
  path         String   @unique
  mimeType     String
  sizeBytes    Int
  role         OrderFileRole @default(GENERAL)
  sortOrder    Int           @default(0)
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  uploadedBy   User     @relation("OrderFileUploader", fields: [uploadedById], references: [id])
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  note         OrderNote? @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([orderItemId, role, sortOrder])
  @@index([noteId, createdAt])
}

model ClientFile {
  id           String   @id @default(cuid())
  clientId     String
  uploadedById String
  name         String
  path         String   @unique
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  uploadedBy   User     @relation("ClientFileUploader", fields: [uploadedById], references: [id])

  @@index([clientId, createdAt])
}

model Shipment {
  id             String          @id @default(cuid())
  orderId        String          @unique
  carrier        ShippingCarrier
  trackingNumber String?
  costMinor      Int             @default(0)
  currency       String
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?
  serviceName       String?
  externalServiceId String?
  externalStatus    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  order          Order           @relation(fields: [orderId], references: [id])
  @@index([carrier, trackingNumber])
}

model OrderShipment {
  id                  String          @id @default(cuid())
  orderId             String
  carrier             ShippingCarrier
  status              ShippingStatus  @default(NOT_READY)
  trackingNumber      String?
  customerChargeMinor Int             @default(0)
  customerChargeOriginalMinor Int?
  customerChargeOriginalCurrency String?
  customerChargeRateSnapshot Json?
  atelierCostMinor    Int             @default(0)
  atelierExpenseId    String?         @unique
  currency            String
  weightGrams         Int?
  lengthMm            Int?
  widthMm             Int?
  heightMm            Int?
  isPrimary           Boolean         @default(false)
  shippedAt           DateTime?
  deliveredAt         DateTime?
  serviceName         String?
  externalServiceId   String?
  externalStatus      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  archivedAt          DateTime?
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  atelierExpense      Expense?        @relation(fields: [atelierExpenseId], references: [id], onDelete: SetNull)
  instances           OrderItemInstance[]

  @@index([orderId, archivedAt])
  @@index([carrier, trackingNumber])
}

model OrderItem {
  id               String           @id @default(cuid())
  orderId          String
  athleteId        String?
  measurementId    String?
  name             String
  quantity         Int              @default(1)
  priceMinor       Int
  modelImagePath   String?
  externalImageUrl String?
  sku              String?
  designNumber     Int?
  discipline       Discipline?
  archivedAt       DateTime?
  properties       Json?
  sourceSystem     String?
  sourceAccount    String?
  externalId       String?
  productionStatus ProductionStatus @default(NOT_SCHEDULED)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  athlete          Athlete?         @relation(fields: [athleteId], references: [id])
  measurement      Measurement?     @relation(fields: [measurementId], references: [id])
  instances         OrderItemInstance[]
  files             OrderFile[]
  structuredNotes   OrderNote[]

  @@unique([sourceSystem, sourceAccount, externalId])
  @@index([orderId, productionStatus])
  @@index([orderId, archivedAt])
  @@index([athleteId])
}

model OrderItemInstance {
  id               String           @id @default(cuid())
  orderItemId      String
  ordinal          Int
  standardHeight   Int?
  athleteId        String?
  measurementId    String?
  orderShipmentId  String?
  productionStatus ProductionStatus @default(NOT_SCHEDULED)
  plannedStartAt   DateTime?
  plannedEndAt     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  archivedAt       DateTime?
  orderItem        OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  athlete          Athlete?         @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  measurement      Measurement?     @relation(fields: [measurementId], references: [id], onDelete: Restrict)
  orderShipment    OrderShipment?   @relation(fields: [orderShipmentId], references: [id], onDelete: SetNull)
  notes            OrderNote[]

  @@unique([orderItemId, ordinal])
  @@index([athleteId])
  @@index([measurementId])
  @@index([orderShipmentId])
  @@index([productionStatus, archivedAt])
  parentMeasurementAssignmentEvents MeasurementSubmissionTarget[] @relation("ParentMeasurementTargetInstance")
}

model OrderCompositionOperation {
  id           String   @id @default(cuid())
  orderId      String
  actorId      String
  operationKey String
  requestHash  String
  result       Json
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([orderId, operationKey])
}

model OrderTag {
  id        String   @id @default(cuid())
  orderId   String
  label     String
  color     String?
  createdAt DateTime @default(now())
  archivedAt DateTime?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, label])
  @@index([orderId, archivedAt, createdAt])
}

model OrderNote {
  id             String              @id @default(cuid())
  orderId        String
  authorId       String?
  designItemId   String?
  itemInstanceId String?
  athleteId      String?
  category       OrderNoteCategory   @default(GENERAL)
  visibility     OrderNoteVisibility @default(INTERNAL)
  title          String
  body           String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  archivedAt     DateTime?
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  author         User?               @relation("OrderNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  designItem     OrderItem?          @relation(fields: [designItemId], references: [id], onDelete: SetNull)
  itemInstance   OrderItemInstance?  @relation(fields: [itemInstanceId], references: [id], onDelete: SetNull)
  athlete        Athlete?            @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  revisions      OrderNoteRevision[]
  files          OrderFile[]

  @@index([orderId, category, archivedAt, createdAt])
  @@index([designItemId])
  @@index([itemInstanceId])
  @@index([athleteId])
}

model OrderNoteRevision {
  id         String              @id @default(cuid())
  noteId     String
  editorId   String?
  category   OrderNoteCategory
  visibility OrderNoteVisibility
  title      String
  body       String
  createdAt  DateTime            @default(now())
  note       OrderNote           @relation(fields: [noteId], references: [id], onDelete: Restrict)
  editor     User?               @relation("OrderNoteRevisionEditor", fields: [editorId], references: [id], onDelete: SetNull)

  @@index([noteId, createdAt])
}

model Payment {
  taxEntries TaxEntry[]
  id          String        @id @default(cuid())
  orderId     String
  amountMinor Int
  currency    String
  method      PaymentMethod
  receivedAt  DateTime
  reference   String?
  notes       String?
  appliedAmountMinor Int?
  appliedCurrency    String?
  exchangeRateSnapshot Json?
  sourceSystem   String?
  sourceAccount  String?
  externalId     String?
  externalStatus String?
  voidedAt       DateTime?
  voidReason     String?
  createdAt   DateTime      @default(now())
  order       Order         @relation(fields: [orderId], references: [id])

  @@unique([sourceSystem, sourceAccount, externalId])
  @@index([orderId, receivedAt])
}

model Conversation {
  id               String                   @id @default(cuid())
  clientId         String
  channel          ContactChannel
  externalId       String?
  subject          String?
  lastMessageAt    DateTime?
  unreadCount      Int                      @default(0)
  unreadVersion    Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  archivedAt       DateTime?
  client           Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  messages         Message[]
  deliveryAttempts MessageDeliveryAttempt[]
  facts            ConversationFact[]
  agreements       Agreement[]
  summaries        ConversationSummary[]
  aiRuns           AiRun[]
  aiModeOverrides  AiModeOverride[]
  aiRuntimeSettings AiRuntimeSetting[] @relation("AiRuntimeSettingConversation")

  @@unique([clientId, channel])
  @@unique([externalId, channel])
  @@index([lastMessageAt, archivedAt])
}

model Message {
  id                      String                   @id @default(cuid())
  conversationId          String
  direction               MessageDirection
  status                  MessageStatus
  content                 String
  normalizedText          String?
  language                String?
  messageType             String                   @default("text")
  externalId              String?
  metadata                Json?
  rawPayload              Json?
  webhookEnvelopeId       String?
  sentAt                  DateTime?
  receivedAt              DateTime?
  replyToMessageId        String?
  aiProcessedAt           DateTime?
  aiAnalysisVersion       String?
  authorId                String?
  createdAt               DateTime                 @default(now())
  conversation            Conversation             @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  author                  User?                    @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  workTasks               WorkTask[]
  deliveryAttempts        MessageDeliveryAttempt[]
  communicationAttachment CommunicationAttachment?
  attachments             MessageAttachment[]
  replyToMessage          Message?                 @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies                 Message[]                @relation("MessageReplies")
  analyses                MessageAnalysis[]
  sourcedMemories         CustomerMemory[]
  sourcedFacts            ConversationFact[]
  customerAgreements      Agreement[]              @relation("AgreementCustomerMessage")
  staffAgreements         Agreement[]              @relation("AgreementStaffMessage")
  aiRuns                  AiRun[]
  aiFeedbackSent          AiResponseFeedback[]     @relation("AiFeedbackSentMessage")
  aiJobs                  AiJob[]
  webhookEnvelope         WebhookEnvelope?         @relation(fields: [webhookEnvelopeId], references: [id], onDelete: SetNull)

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  @@index([replyToMessageId])
