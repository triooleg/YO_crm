generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  PRODUCTION
  ACCOUNTANT
  VIEWER
}

enum ClientStatus {
  LEAD
  ACTIVE
  VIP
  INACTIVE
  BLOCKED
}

enum ContactChannel {
  WEBSITE
  CHATWOOT
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  EMAIL
  TELEGRAM
  REFERRAL
  RETURNING_CUSTOMER
  MANUAL
  OTHER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageStatus {
  RECEIVED
  DRAFT
  SENT
  FAILED
}

enum AiMode {
  OFF
  SHADOW
  ASSIST
  AUTO_SAFE
  AGENT
  AUTONOMOUS
}

enum AiSettingScope {
  GLOBAL
  CHANNEL
  CLIENT
  CONVERSATION
}

enum AiRecordStatus {
  ACTIVE
  VERIFIED
  SUPERSEDED
  REJECTED
}

enum AiRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AiJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum WorkTaskType {
  CLIENT
  ADMINISTRATIVE
  PRODUCTION
}

enum Discipline {
  RHYTHMIC_GYMNASTICS
  ACROBATIC_GYMNASTICS
  FIGURE_SKATING
  AEROBIC_GYMNASTICS
  BATON_TWIRLING_MAJORETTE
  OTHER
}

enum OrderType {
  READY_MODEL
  CUSTOM_ORDER
  COPY_MODEL
  MODIFIED_MODEL
  PAIR
  GROUP_ORDER
  REPEAT_ORDER
  ACCESSORY
}

enum SalesStatus {
  NEW_LEAD
  WAITING_CLIENT_REPLY
  NEEDS_ESTIMATE
  ESTIMATE_SENT
  DESIGN_DISCUSSION
  WAITING_COACH_APPROVAL
  WAITING_DEPOSIT
  DEPOSIT_RECEIVED
  ORDER_CONFIRMED
  MEASUREMENTS_REQUIRED
  MEASUREMENTS_RECEIVED
  READY_FOR_PRODUCTION
  IN_PRODUCTION
  FINAL_DECORATION
  QUALITY_CONTROL
  PHOTO_SENT
  WAITING_FINAL_PAYMENT
  PAID
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  REVIEW_REQUESTED
  COMPLETED
  CANCELLED
}

enum ProductionStatus {
  NOT_SCHEDULED
  TENTATIVE
  SCHEDULED
  MATERIALS
  CUTTING
  SEWING
  DECORATION
  QUALITY_CONTROL
  READY
  ON_HOLD
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  DEPOSIT_PAID
  PAID
  REFUNDED
  CANCELLED
}

enum ShippingStatus {
  NOT_READY
  READY
  LABEL_CREATED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
  LOST
}

enum ShippingCarrier {
  NOVA_POSHTA
  NOVA_GLOBAL
  UKRPOSHTA
  DHL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  PAYPAL
  CASH
  OTHER
}

enum BackupType {
  DATA
  FULL
}

enum BackupStatus {
  PENDING
  RUNNING
  VERIFYING
  COMPLETED
  FAILED
  RESTORING
}

enum BackupStorageProvider {
  LOCAL
  S3
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  passwordHash             String
  displayName              String
  role                     UserRole                  @default(MANAGER)
  active                   Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  archivedAt               DateTime?
  sessions                 Session[]
  clients                  Client[]                  @relation("ClientManager")
  orders                   Order[]                   @relation("OrderManager")
  auditLogs                AuditLog[]                @relation("AuditActor")
  authoredMessages         Message[]                 @relation("MessageAuthor")
  communicationAttachments CommunicationAttachment[]
  assignedTasks            WorkTask[]                @relation("TaskAssignee")
  createdTasks             WorkTask[]                @relation("TaskCreator")
  createdBackups           Backup[]                  @relation("BackupCreator")
  createdKnowledgeItems    KnowledgeItem[]           @relation("KnowledgeCreatedBy")
  updatedKnowledgeItems    KnowledgeItem[]           @relation("KnowledgeUpdatedBy")
  updatedAiRuntimeSettings AiRuntimeSetting[]         @relation("AiRuntimeSettingUpdatedBy")
  createdClientMergeOperations ClientMergeOperation[] @relation("ClientMergeOperationCreator")
  splitClientMergeOperations   ClientMergeOperation[] @relation("ClientMergeOperationSplitter")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Client {
  id                      String                   @id @default(cuid())
  firstName               String
  lastName                String?
  displayName             String
  avatarUrl               String?
  country                 String?
  city                    String?
  address                 String?
  postalCode              String?
  email                   String?
  phone                   String?
  whatsapp                String?
  instagram               String?
  instagramUsername       String?
  facebook                String?
  telegram                String?
  preferredChannel        ContactChannel?
  language                String?
  timezone                String?
  firstContactAt          DateTime?
  source                  ContactChannel           @default(MANUAL)
  status                  ClientStatus             @default(LEAD)
  notes                   String?
  responsibleManagerId    String?
  nextActionAt            DateTime?
  lastContactAt           DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  archivedAt              DateTime?
  responsibleManager      User?                    @relation("ClientManager", fields: [responsibleManagerId], references: [id])
  athletes                Athlete[]
  orders                  Order[]
  activities              Activity[]
  conversations           Conversation[]
  messageDeliveryAttempts MessageDeliveryAttempt[]
  workTasks               WorkTask[]
  aiMemories              CustomerMemory[]
  conversationFacts       ConversationFact[]
  agreements              Agreement[]
  aiRuns                  AiRun[]
  aiModeOverrides         AiModeOverride[]
  aiRuntimeSettings       AiRuntimeSetting[]        @relation("AiRuntimeSettingClient")
  mergeRedirectSource     ClientMergeRedirect?      @relation("MergedClientSource")
  incomingMergeRedirects  ClientMergeRedirect[]     @relation("MergedClientTarget")
  mergeOperationsAsSource ClientMergeOperation[]    @relation("ClientMergeOperationSource")
  mergeOperationsAsTarget ClientMergeOperation[]    @relation("ClientMergeOperationTarget")

  @@index([displayName])
  @@index([email])
  @@index([phone])
  @@index([status, archivedAt])
}

model ClientMergeRedirect {
  sourceClientId String   @id
  targetClientId String
  createdById    String?
  createdAt      DateTime @default(now())
  sourceClient   Client   @relation("MergedClientSource", fields: [sourceClientId], references: [id], onDelete: Restrict)
  targetClient   Client   @relation("MergedClientTarget", fields: [targetClientId], references: [id], onDelete: Restrict)

  @@index([targetClientId])
}

model ClientMergeOperation {
  id                   String   @id @default(cuid())
  sourceClientId       String
  targetClientId       String
  createdById          String
  splitById            String?
  sourceSnapshot       Json
  targetBeforeSnapshot Json
  targetAfterSnapshot  Json
  movedEntityIds       Json
  deletedAiSettings    Json
  createdAt            DateTime @default(now())
  splitAt              DateTime?
  sourceClient         Client   @relation("ClientMergeOperationSource", fields: [sourceClientId], references: [id], onDelete: Restrict)
  targetClient         Client   @relation("ClientMergeOperationTarget", fields: [targetClientId], references: [id], onDelete: Restrict)
  createdBy            User     @relation("ClientMergeOperationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  splitBy              User?    @relation("ClientMergeOperationSplitter", fields: [splitById], references: [id], onDelete: Restrict)

  @@index([sourceClientId, splitAt])
  @@index([targetClientId, splitAt])
}

model Athlete {
  id           String        @id @default(cuid())
  clientId     String
  firstName    String
  lastName     String?
  birthDate    DateTime?
  discipline   Discipline?
  club         String?
  coach        String?
  country      String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  archivedAt   DateTime?
  client       Client        @relation(fields: [clientId], references: [id])
  measurements Measurement[]
  orders       Order[]
  orderItems   OrderItem[]

  @@index([clientId, archivedAt])
}

model Measurement {
  id         String      @id @default(cuid())
  athleteId  String
  measuredAt DateTime
  unit       String      @default("cm")
  height     Decimal?    @db.Decimal(6, 2)
  chest      Decimal?    @db.Decimal(6, 2)
  waist      Decimal?    @db.Decimal(6, 2)
  hips       Decimal?    @db.Decimal(6, 2)
  torso      Decimal?    @db.Decimal(6, 2)
  values     Json?
  notes      String?
  source     String?
  createdAt  DateTime    @default(now())
  athlete    Athlete     @relation(fields: [athleteId], references: [id])
  orders     Order[]
  orderItems OrderItem[]

  @@index([athleteId, measuredAt])
}

model Order {
  id                   String           @id @default(cuid())
  number               String           @unique
  clientId             String
  athleteId            String?
  measurementId        String?
  type                 OrderType
  discipline           Discipline?
  country              String?
  deliveryAddressSet   Boolean          @default(false)
  deliveryRecipient    String?
  deliveryAddressLine1 String?
  deliveryAddressLine2 String?
  deliveryCity         String?
  deliveryRegion       String?
  deliveryPostalCode   String?
  deliveryAddressText  String?
  requiredDeliveryAt   DateTime?
  promisedProductionAt DateTime?
  priority             Int              @default(0)
  responsibleManagerId String?
  productionOwner      String?
  priceMinor           Int
  currency             String           @default("EUR")
  depositRequiredMinor Int
  deliveryMinor        Int              @default(0)
  discountMinor        Int              @default(0)
  productionCostMinor  Int?
  salesStatus          SalesStatus      @default(NEW_LEAD)
  productionStatus     ProductionStatus @default(NOT_SCHEDULED)
  paymentStatus        PaymentStatus    @default(UNPAID)
  shippingStatus       ShippingStatus   @default(NOT_READY)
  notes                String?
  modelImagePath       String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  archivedAt           DateTime?
  client               Client           @relation(fields: [clientId], references: [id])
  athlete              Athlete?         @relation(fields: [athleteId], references: [id])
  measurement          Measurement?     @relation(fields: [measurementId], references: [id])
  responsibleManager   User?            @relation("OrderManager", fields: [responsibleManagerId], references: [id])
  items                OrderItem[]
  payments             Payment[]
  productionSlot       ProductionSlot?
  activities           Activity[]

  invoices   Invoice[]
  expenses   Expense[]
  shipment   Shipment?
  agreements Agreement[]

  @@index([salesStatus, archivedAt])
  @@index([requiredDeliveryAt])
  @@index([clientId, createdAt])
}

model Shipment {
  id             String          @id @default(cuid())
  orderId        String          @unique
  carrier        ShippingCarrier
  trackingNumber String?
  costMinor      Int             @default(0)
  currency       String
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  order          Order           @relation(fields: [orderId], references: [id])

  @@index([carrier, trackingNumber])
}

model OrderItem {
  id               String           @id @default(cuid())
  orderId          String
  athleteId        String?
  measurementId    String?
  name             String
  quantity         Int              @default(1)
  priceMinor       Int
  modelImagePath   String?
  productionStatus ProductionStatus @default(NOT_SCHEDULED)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  athlete          Athlete?         @relation(fields: [athleteId], references: [id])
  measurement      Measurement?     @relation(fields: [measurementId], references: [id])

  @@index([orderId, productionStatus])
  @@index([athleteId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  amountMinor Int
  currency    String
  method      PaymentMethod
  receivedAt  DateTime
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  order       Order         @relation(fields: [orderId], references: [id])

  @@index([orderId, receivedAt])
}

model Conversation {
  id               String                   @id @default(cuid())
  clientId         String
  channel          ContactChannel
  externalId       String?
  subject          String?
  lastMessageAt    DateTime?
  unreadCount      Int                      @default(0)
  unreadVersion    Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  archivedAt       DateTime?
  client           Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  messages         Message[]
  deliveryAttempts MessageDeliveryAttempt[]
  facts            ConversationFact[]
  agreements       Agreement[]
  summaries        ConversationSummary[]
  aiRuns           AiRun[]
  aiModeOverrides  AiModeOverride[]
  aiRuntimeSettings AiRuntimeSetting[] @relation("AiRuntimeSettingConversation")

  @@unique([clientId, channel])
  @@unique([externalId, channel])
  @@index([lastMessageAt, archivedAt])
}

model Message {
  id                      String                   @id @default(cuid())
  conversationId          String
  direction               MessageDirection
  status                  MessageStatus
  content                 String
  normalizedText          String?
  language                String?
  messageType             String                   @default("text")
  externalId              String?
  metadata                Json?
  rawPayload              Json?
  webhookEnvelopeId       String?
  sentAt                  DateTime?
  receivedAt              DateTime?
  replyToMessageId        String?
  aiProcessedAt           DateTime?
  aiAnalysisVersion       String?
  authorId                String?
  createdAt               DateTime                 @default(now())
  conversation            Conversation             @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  author                  User?                    @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  workTasks               WorkTask[]
  deliveryAttempts        MessageDeliveryAttempt[]
  communicationAttachment CommunicationAttachment?
  attachments             MessageAttachment[]
  replyToMessage          Message?                 @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies                 Message[]                @relation("MessageReplies")
  analyses                MessageAnalysis[]
  sourcedMemories         CustomerMemory[]
  sourcedFacts            ConversationFact[]
  customerAgreements      Agreement[]              @relation("AgreementCustomerMessage")
  staffAgreements         Agreement[]              @relation("AgreementStaffMessage")
  aiRuns                  AiRun[]
  aiFeedbackSent          AiResponseFeedback[]     @relation("AiFeedbackSentMessage")
  aiJobs                  AiJob[]
  webhookEnvelope         WebhookEnvelope?         @relation(fields: [webhookEnvelopeId], references: [id], onDelete: SetNull)

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  @@index([replyToMessageId])
  @@index([aiProcessedAt])
  @@index([webhookEnvelopeId])
}

model WebhookEnvelope {
  id          String    @id @default(cuid())
  provider    String
  payload     Json
  payloadHash String
  receivedAt  DateTime  @default(now())
  messages    Message[]

  @@index([provider, receivedAt])
  @@index([payloadHash])
}

model MessageAttachment {
  id          String   @id @default(cuid())
  messageId   String
  type        String
  storageKey  String?
  externalUrl String?
  mimeType    String?
  width       Int?
  height      Int?
  durationMs  Int?
  metadata    Json?
  createdAt   DateTime @default(now())
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@index([messageId, createdAt])
}

model MessageAnalysis {
  id               String   @id @default(cuid())
  messageId        String
  language         String?
  intent           String?
  sentiment        String?
  entities         Json?
  facts            Json?
  requiresReply    Boolean?
  urgency          Int?
  customerQuestion String?
  customerRequest  String?
  commercialIntent Boolean?
  confidence       Decimal? @db.Decimal(5, 4)
  extractor        String
  model            String?
  promptVersion    String?
  analysisVersion  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  message          Message  @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@unique([messageId, analysisVersion])
  @@index([intent, createdAt])
}

model CustomerMemory {
  id               String           @id @default(cuid())
  clientId         String
  type             String
  key              String
  valueJson        Json
  sourceType       String
  sourceId         String
  sourceMessageId  String?
  confidence       Decimal?         @db.Decimal(5, 4)
  status           AiRecordStatus   @default(ACTIVE)
  extractor        String?
  extractorVersion String?
  supersededById   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sourceMessage    Message?         @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  supersededBy     CustomerMemory?  @relation("MemorySupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes       CustomerMemory[] @relation("MemorySupersession")

  @@index([clientId, key, status])
  @@index([sourceType, sourceId])
}

model ConversationFact {
  id               String         @id @default(cuid())
  conversationId   String
  clientId         String
  type             String
  subject          String
  valueJson        Json
  status           AiRecordStatus @default(ACTIVE)
  confidence       Decimal?       @db.Decimal(5, 4)
  sourceMessageId  String
  extractor        String?
  extractorVersion String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  conversation     Conversation   @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sourceMessage    Message        @relation(fields: [sourceMessageId], references: [id], onDelete: Restrict)

  @@index([conversationId, subject, status])
  @@index([clientId, type, status])
}

model Agreement {
  id                         String         @id @default(cuid())
  conversationId             String
  clientId                   String
  orderId                    String?
  type                       String
  subject                    String
  valueJson                  Json
  status                     AiRecordStatus @default(ACTIVE)
  customerMessageId          String
  staffConfirmationMessageId String?
  confidence                 Decimal?       @db.Decimal(5, 4)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  conversation               Conversation   @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  client                     Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  order                      Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerMessage            Message        @relation("AgreementCustomerMessage", fields: [customerMessageId], references: [id], onDelete: Restrict)
  staffConfirmationMessage   Message?       @relation("AgreementStaffMessage", fields: [staffConfirmationMessageId], references: [id], onDelete: SetNull)

  @@index([conversationId, status])
  @@index([orderId, status])
}

model KnowledgeCategory {
  id         String          @id @default(cuid())
  key        String          @unique
  name       String
  sortOrder  Int             @default(0)
  archivedAt DateTime?
  items      KnowledgeItem[]
}

model KnowledgeItem {
  id             String             @id @default(cuid())
  categoryId     String
  title          String
  language       String             @default("ru")
  status         KnowledgeStatus    @default(DRAFT)
  priority       Int                @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  currentVersion Int                @default(1)
  createdById    String?
  updatedById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  category       KnowledgeCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy      User?              @relation("KnowledgeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?              @relation("KnowledgeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  versions       KnowledgeVersion[]

  @@index([status, language, priority])
  @@index([validFrom, validUntil])
}

model KnowledgeVersion {
  id              String        @id @default(cuid())
  knowledgeItemId String
  version         Int
  content         String
  contentHash     String
  createdById     String?
  createdAt       DateTime      @default(now())
  item            KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Restrict)

  @@unique([knowledgeItemId, version])
  @@index([contentHash])
}

model AiPrompt {
  id        String          @id @default(cuid())
  key       String
  version   Int
  content   String
  status    KnowledgeStatus @default(DRAFT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([key, version])
  @@index([key, status])
}

model AiRun {
  id                    String              @id @default(cuid())
  conversationId        String?
  messageId             String?
  clientId              String?
  agent                 String
  operation             String
  provider              String
  model                 String
  promptKey             String?
  promptVersion         Int?
  contextSnapshot       Json?
  retrievedKnowledgeIds String[]
  retrievedMemoryIds    String[]
  retrievedMessageIds   String[]
  availableTools        Json?
  toolCalls             Json?
  generatedOutput       String?
  confidence            Decimal?            @db.Decimal(5, 4)
  status                AiRunStatus         @default(PENDING)
  errorCode             String?
  latencyMs             Int?
  inputTokens           Int?
  outputTokens          Int?
  estimatedCostMinor    Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  conversation          Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message               Message?            @relation(fields: [messageId], references: [id], onDelete: SetNull)
  client                Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  feedback              AiResponseFeedback?

  @@index([conversationId, createdAt])
  @@index([clientId, createdAt])
  @@index([status, createdAt])
}

model AiResponseFeedback {
  id            String   @id @default(cuid())
  aiRunId       String   @unique
  draftText     String
  finalText     String?
  wasEdited     Boolean?
  editDistance  Int?
  accepted      Boolean?
  rejected      Boolean  @default(false)
  sentMessageId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  aiRun         AiRun    @relation(fields: [aiRunId], references: [id], onDelete: Restrict)
  sentMessage   Message? @relation("AiFeedbackSentMessage", fields: [sentMessageId], references: [id], onDelete: SetNull)
}

model ConversationSummary {
  id                String       @id @default(cuid())
  conversationId    String
  summary           String
  structuredSummary Json?
  throughMessageId  String
  fromDate           DateTime?    @db.Date
  timezone           String?
  sourceDigest       String?
  sourceMessageCount Int?
  throughMessageAt   DateTime?
  model             String
  promptVersion     String?
  completedAt       DateTime?
  processingState   Json?
  processingLeaseUntil DateTime?
  processingLeaseToken String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@unique([conversationId, fromDate, sourceDigest])
}

model AiModeOverride {
  id             String          @id @default(cuid())
  mode           AiMode
  channel        ContactChannel?
  clientId       String?
  conversationId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  conversation   Conversation?   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([channel])
  @@index([clientId])
  @@index([conversationId])
}

model AiRuntimeSetting {
  id          String         @id @default(cuid())
  key         String
  value       Json
  valueType   String
  scope       AiSettingScope @default(GLOBAL)
  scopeId     String         @default("")
  channel     ContactChannel?
  clientId    String?
  conversationId String?
  updatedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  updatedBy   User?          @relation("AiRuntimeSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  client      Client?        @relation("AiRuntimeSettingClient", fields: [clientId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation("AiRuntimeSettingConversation", fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([scope, scopeId, key])
  @@index([scope, scopeId])
  @@index([key])
  @@index([clientId])
  @@index([conversationId])
}

model AiJob {
  id          String      @id @default(cuid())
  type        String
  messageId   String?
  payload     Json
  status      AiJobStatus @default(PENDING)
  attempts    Int         @default(0)
  availableAt DateTime    @default(now())
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  message     Message?    @relation(fields: [messageId], references: [id], onDelete: SetNull)
  attemptLog  AiJobAttempt[]

  @@index([status, availableAt])
}

model AiJobAttempt {
  id        String   @id @default(cuid())
  jobId     String
  createdAt DateTime @default(now())
  job       AiJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([jobId, createdAt])
}

model CommunicationAttachment {
  id              String    @id @default(cuid())
  path            String    @unique
  originalName    String
  mimeType        String
  sizeBytes       Int
  createdById     String
  clientRequestId String?   @unique
  messageId       String?   @unique
  createdAt       DateTime  @default(now())
  claimedAt       DateTime?
  createdBy       User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  message         Message?  @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@index([createdById, createdAt])
  @@index([claimedAt, createdAt])
}

model MessageDeliveryAttempt {
  id              String       @id @default(cuid())
  clientRequestId String       @unique
  clientId        String
  conversationId  String
  status          String
  messageId       String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message         Message?     @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
}

model TaskColumn {
  id         String     @id @default(cuid())
  name       String
  color      String     @default("#7047eb")
  isDone     Boolean    @default(false)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  archivedAt DateTime?
  tasks      WorkTask[]

  @@index([sortOrder, archivedAt])
}

model WorkTask {
  id              String           @id @default(cuid())
  columnId        String
  clientId        String?
  sourceMessageId String?
  assigneeId      String?
  createdById     String?
  type            WorkTaskType     @default(CLIENT)
  title           String
  description     String?
  markerColor     String           @default("#7047eb")
  labels          String[]
  dueAt           DateTime?
  position        Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  completedAt     DateTime?
  archivedAt      DateTime?
  column          TaskColumn       @relation(fields: [columnId], references: [id], onDelete: Restrict)
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sourceMessage   Message?         @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  assignee        User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attachments     TaskAttachment[]

  @@index([columnId, position, archivedAt])
  @@index([assigneeId, dueAt])
  @@index([clientId, createdAt])
  @@index([sourceMessageId])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  path      String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())
  task      WorkTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

model MessageTemplate {
  id         String          @id @default(cuid())
  name       String
  content    String
  channel    ContactChannel?
  language   String          @default("ru")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  archivedAt DateTime?

  @@index([archivedAt, name])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String
  section   String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([section, key])
  @@index([section])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
}

model Expense {
  id          String          @id @default(cuid())
  categoryId  String
  orderId     String?
  amountMinor Int
  currency    String
  incurredAt  DateTime
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  archivedAt  DateTime?
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  order       Order?          @relation(fields: [orderId], references: [id])

  @@index([incurredAt, archivedAt])
  @@index([orderId])
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique
  orderId    String
  status     InvoiceStatus @default(DRAFT)
  language   String        @default("ru")
  currency   String
  issueDate  DateTime
  dueDate    DateTime?
  seller     Json
  customer   Json
  items      Json
  notes      String?
  totalMinor Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  archivedAt DateTime?
  order      Order         @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@index([issueDate, status])
}

model ProductionSlot {
  id        String   @id @default(cuid())
  orderId   String   @unique
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int      @default(1)
  tentative Boolean  @default(true)
  locked    Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id])

  @@index([startsAt, endsAt])
}

model Activity {
  id        String   @id @default(cuid())
  clientId  String?
  orderId   String?
  type      String
  summary   String
  metadata  Json?
  createdAt DateTime @default(now())
  client    Client?  @relation(fields: [clientId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])

  @@index([clientId, createdAt])
  @@index([orderId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Backup {
  id              String                @id
  type            BackupType
  status          BackupStatus          @default(PENDING)
  storageProvider BackupStorageProvider @default(LOCAL)
  storagePath     String?
  sizeBytes       BigInt?
  checksum        String?
  appVersion      String?
  gitCommit       String?
  databaseVersion String?
  schemaVersion   String?
  createdById     String?
  errorMessage    String?
  metadata        Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  archivedAt      DateTime?
  createdBy       User?                 @relation("BackupCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([archivedAt, createdAt])
}

model BackupSetting {
  id              String                @id @default("default")
  enabled         Boolean               @default(false)
  frequency       String                @default("DAILY")
  time            String                @default("03:00")
  timezone        String                @default("Europe/Kiev")
  backupType      BackupType            @default(DATA)
  retentionCount  Int                   @default(10)
  storageProvider BackupStorageProvider @default(LOCAL)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}
