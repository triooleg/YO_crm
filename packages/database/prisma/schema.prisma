}

model MeasurementSubmission {
  id String @id @default(cuid())
  childId String
  participantId String
  revision Int
  operationKey String
  requestHash String
  measurementId String @unique
  athleteId String
  previousSubmissionId String?
  payload Json
  reviewStatus String @default("RECEIVED")
  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  child MeasurementParticipantChild @relation(fields:[childId,participantId],references:[id,participantId],onDelete:Restrict)
  measurement Measurement @relation(fields:[measurementId],references:[id],onDelete:Restrict)
  @@unique([participantId,operationKey])
  @@unique([childId,revision])
  @@index([childId,submittedAt])
  athlete Athlete @relation("ParentMeasurementSubmissionAthlete", fields: [athleteId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pm_submission_athlete_fk")
  previousSubmission MeasurementSubmission? @relation("ParentMeasurementSubmissionPrevious", fields: [previousSubmissionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pm_submission_previous_fk")
  subsequentSubmissions MeasurementSubmission[] @relation("ParentMeasurementSubmissionPrevious")
  targets MeasurementSubmissionTarget[] @relation("ParentMeasurementTargetSubmission")
  publicEvents MeasurementPublicEvent[] @relation("ParentMeasurementEventSubmission")
  @@index([athleteId], map: "pm_submission_athlete_idx")
}

model MeasurementSubmissionTarget {
  id String @id @default(cuid())
  submissionId String
  instanceId String
  staffActorId String?
  beforeMeasurementId String?
  afterMeasurementId String
  createdAt DateTime @default(now())
  @@index([submissionId,createdAt])
  @@index([instanceId,createdAt])
  submission MeasurementSubmission @relation("ParentMeasurementTargetSubmission", fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pm_target_submission_fk")
  instance OrderItemInstance @relation("ParentMeasurementTargetInstance", fields: [instanceId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pm_target_instance_fk")
  staffActor User? @relation("ParentMeasurementTargetActor", fields: [staffActorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pm_target_actor_fk")
  beforeMeasurement Measurement? @relation("ParentMeasurementTargetBefore", fields: [beforeMeasurementId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pm_target_before_fk")
  afterMeasurement Measurement @relation("ParentMeasurementTargetAfter", fields: [afterMeasurementId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pm_target_after_fk")
}

model MeasurementPublicEvent {
  id String @id @default(cuid())
  invitationId String
  participantId String?
  submissionId String?
  actorType String
  staffActorId String?
  kind String
  metadata Json?
  createdAt DateTime @default(now())
  @@index([invitationId,createdAt])
  @@index([submissionId,createdAt])
  invitation MeasurementInvitation @relation("ParentMeasurementEventInvitation", fields: [invitationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pm_event_invite_fk")
  participant MeasurementParticipant? @relation("ParentMeasurementEventParticipant", fields: [participantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pm_event_participant_fk")
  submission MeasurementSubmission? @relation("ParentMeasurementEventSubmission", fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pm_event_submission_fk")
  staffActor User? @relation("ParentMeasurementEventActor", fields: [staffActorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pm_event_actor_fk")
}

model MeasurementDraftAsset {
  id String @id @default(cuid())
  childId String
  participantId String
  storageKey String @unique
  mimeType String
  sizeBytes Int
  createdAt DateTime @default(now())
  archivedAt DateTime?
  @@index([childId])
  child MeasurementParticipantChild @relation("ParentMeasurementAssetChild", fields: [childId, participantId], references: [id, participantId], onDelete: Restrict, onUpdate: NoAction, map: "pm_asset_child_fk")
}


// Tax economic rows are append-only. PostgreSQL constraints/triggers live in
// 20261019123000_fop_tax_ledger; pending receipt events never carry money.
model TaxPolicy {
 id String @id @default(cuid())
 effectiveFrom String
 group Int
 unifiedMode String
 unifiedRateBps Int
 fixedUnifiedMinor BigInt?
 fixedUnifiedWageRateBps Int?
 militaryRateBps Int
 esvRateBps Int
 state String @default("PUBLISHED")
 snapshot Json
 createdAt DateTime @default(now())
 periods TaxPeriod[]
 entries TaxEntry[]
}
model TaxPeriod {
 id String @id @default(cuid())
 month String @unique
 policyId String
 state String @default("OPEN")
 revision Int @default(0)
 snapshot Json
 closedAt DateTime?
 closedSnapshot Json?
 createdAt DateTime @default(now())
 policy TaxPolicy @relation(fields:[policyId],references:[id],onDelete:Restrict)
 entries TaxEntry[] @relation("TaxEntryPeriod")
 originalEntries TaxEntry[] @relation("TaxEntryOriginalPeriod")
}
model TaxEntry {
 sequence BigInt @unique @default(autoincrement())
 id String @id @default(cuid())
 periodId String
 originalPeriodId String?
 policyId String
 paymentId String?
 orderId String?
 component String
 kind String
 rootId String?
 reversesEntryId String?
 sourceKey String? @unique
 operationKey String @unique
 payloadHash String
 amountMinor BigInt?
 baseMinor BigInt?
 snapshot Json
 createdAt DateTime @default(now())
 period TaxPeriod @relation("TaxEntryPeriod",fields:[periodId],references:[id],onDelete:Restrict)
 originalPeriod TaxPeriod? @relation("TaxEntryOriginalPeriod",fields:[originalPeriodId],references:[id],onDelete:Restrict)
 policy TaxPolicy @relation(fields:[policyId],references:[id],onDelete:Restrict)
 payment Payment? @relation(fields:[paymentId],references:[id],onDelete:Restrict)
 order Order? @relation(fields:[orderId],references:[id],onDelete:Restrict)
 root TaxEntry? @relation("TaxEntryRoot",fields:[rootId],references:[id],onDelete:Restrict)
 events TaxEntry[] @relation("TaxEntryRoot")
 reversesEntry TaxEntry? @relation("TaxEntryReversal",fields:[reversesEntryId],references:[id],onDelete:Restrict)
 reversalEvents TaxEntry[] @relation("TaxEntryReversal")
 allocations TaxExpenseAllocation[]
 @@index([periodId,component,createdAt])
 @@index([rootId,createdAt])
 @@index([paymentId,createdAt])
}
model TaxExpenseAllocation {
 sequence BigInt @unique @default(autoincrement())
 id String @id @default(cuid())
 kind String
 expenseId String
 linkId String?
 rootId String?
 reversesId String?
 component String
 amountMinor BigInt
 incurredAt DateTime
 snapshot Json
 operationKey String @unique
 payloadHash String
 createdAt DateTime @default(now())
 expense Expense @relation(fields:[expenseId],references:[id],onDelete:Restrict)
 link TaxExpenseAllocation? @relation("TaxExpenseLink",fields:[linkId],references:[id],onDelete:Restrict)
 allocations TaxExpenseAllocation[] @relation("TaxExpenseLink")
 reverses TaxExpenseAllocation? @relation("TaxAllocationReversal",fields:[reversesId],references:[id],onDelete:Restrict)
 reversalEvents TaxExpenseAllocation[] @relation("TaxAllocationReversal")
 root TaxEntry? @relation(fields:[rootId],references:[id],onDelete:Restrict)
 @@index([rootId])
 @@index([expenseId,createdAt])
}

// Historical NBU evidence: READY first observation is immutable; failures retry.
model HistoricalNbuRate {
 currency String
 incomeDate String
 provider String @default("NBU")
 status String
 attempts Int @default(1)
 leaseToken String?
 leaseUntil DateTime? @db.Timestamptz(3)
 retryAt DateTime? @db.Timestamptz(3)
 lastErrorCode String?
 numerator String?
 denominator String?
 effectiveDate String?
 url String?
 fetchedAt DateTime? @db.Timestamptz(3)
 raw String?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
 @@id([currency,incomeDate])
}

model WebsiteApiKey {
  id String @id @default(cuid())
  name String @db.VarChar(100)
  selector String @unique @db.VarChar(16)
  digest Bytes @unique
  digestVersion String @default("sha256-v1")
  sourceAccount String @db.VarChar(253)
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?
  createdById String
  revokedById String?
  rotatedFromId String?
  createdBy User @relation("WebsiteApiKeyCreator",fields:[createdById],references:[id],onDelete:Restrict)
  revokedBy User? @relation("WebsiteApiKeyRevoker",fields:[revokedById],references:[id],onDelete:Restrict)
  rotatedFrom WebsiteApiKey? @relation("WebsiteApiKeyRotation",fields:[rotatedFromId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  rotations WebsiteApiKey[] @relation("WebsiteApiKeyRotation")
  @@index([createdAt,id])
}
