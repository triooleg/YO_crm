{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": { "maxFileSize": 256000 },
  "output": {
    "filePath": ".codex/cache/repomix-output.xml",
    "style": "xml",
    "filePathStyle": "target-relative",
    "parsableStyle": true,
    "compress": true,
    "fileSummary": true,
    "directoryStructure": true,
    "files": false,
    "removeComments": true,
    "removeEmptyLines": true,
    "truncateBase64": true,
    "copyToClipboard": false,
    "tokenBudget": 3000,
    "topFilesLength": 10,
    "git": { "sortByChanges": false, "includeDiffs": false, "includeLogs": false }
  },
  "include": ["apps/**", "packages/**", "package.json", "pnpm-workspace.yaml"],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": ["**/.env*", "**/node_modules/**", "**/.next*/**", "**/dist/**", "**/coverage/**", "**/uploads/**", "**/backups/**", "**/*.log", "**/*.sql", "**/*.dump", "**/*.sqlite*", "**/*.{png,jpg,jpeg,gif,webp,mp4,mov,zip,tar,tgz}"]
  },
  "security": { "enableSecurityCheck": true },
  "tokenCount": { "encoding": "o200k_base" }
}
