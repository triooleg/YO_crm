{
    "name":  "yoleotard-crm",
    "version":  "0.1.55",
    "private":  true,
    "packageManager":  "pnpm@11.16.0",
    "engines":  {
                    "node":  "\u003e=22"
                },
    "scripts":  {
                    "dev":  "pnpm --parallel --filter @yoleotard-crm/api --filter @yoleotard-crm/web dev",
                    "build":  "pnpm db:generate && pnpm --filter @yoleotard-crm/api build && pnpm --filter @yoleotard-crm/web build",
                    "typecheck":  "pnpm -r typecheck",
                    "test":  "pnpm -r test",
                    "dag":  "node tools/dag/cli.mjs",
                    "dag:status":  "node tools/dag/cli.mjs status",
                    "dag:test":  "node --test tools/dag/tests/orchestrator.test.mjs tools/dag/tests/cli.test.mjs tools/dag/tests/context.test.mjs",
                    "dag:benchmark":  "node tools/dag/benchmark.mjs",
                    "quality:check":  "pnpm test && pnpm typecheck && pnpm build",
                    "db:generate":  "pnpm --filter @yoleotard-crm/database exec prisma generate --schema prisma/schema.prisma",
                    "db:migrate":  "pnpm --filter @yoleotard-crm/database exec prisma migrate dev --schema prisma/schema.prisma",
                    "db:deploy":  "pnpm --filter @yoleotard-crm/database exec prisma migrate deploy --schema prisma/schema.prisma",
                    "db:seed":  "pnpm --filter @yoleotard-crm/database seed"
                }
}
